FROM registry.access.redhat.com/ubi9/ubi:latest

ARG IMAGE_VERSION=6.1.0-rc3
ARG SUPERSET_PY_VERSION=6.1.0rc3
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"

USER root

RUN dnf -y update && \
    dnf -y install \
      python3.11 \
      python3.11-pip \
      python3.11-devel \
      make \
      gcc \
      gcc-c++ \
      curl-minimal \
      cyrus-sasl-devel \
      cyrus-sasl-gssapi \
      libffi-devel \
      openldap-devel \
      openssl-devel \
      postgresql-devel \
      findutils \
    && dnf clean all

WORKDIR /app

COPY . /app

RUN python3.11 -c "import json; p='/app/superset-frontend/package.json'; d=json.load(open(p)); d['version']='${SUPERSET_PY_VERSION}'; open(p, 'w').write(json.dumps(d, indent=2) + '\\n')"

RUN mkdir -p /app/superset/static && \
    touch /app/superset/static/version_info.json

RUN python3.11 -m venv /app/.venv && \
    /app/.venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel uv && \
    /app/.venv/bin/python setup.py bdist_wheel && \
    WHEEL_FILE="$(find /app/dist -maxdepth 1 -type f -name '*.whl' | head -n 1)" && \
    test -n "$WHEEL_FILE" && \
    /app/.venv/bin/python -m pip install --no-cache-dir "$WHEEL_FILE" && \
    /app/.venv/bin/python -m pip install --no-cache-dir /app/superset-core && \
    /app/.venv/bin/python -m pip install --no-cache-dir "pymysql" && \
    /app/.venv/bin/python -m pip install --no-cache-dir "psycopg2-binary" && \
    /app/.venv/bin/python -m pip install --no-cache-dir "trino" && \
    /app/.venv/bin/python -m pip install --no-cache-dir "sqlalchemy-trino" && \
    /app/.venv/bin/python -m pip install --no-cache-dir "fastmcp==3.2.0" && \
    /app/.venv/bin/python -c "import importlib.metadata as m; v=m.version('apache-superset'); print('apache-superset version:', v); assert v == '${SUPERSET_PY_VERSION}', f'expected ${SUPERSET_PY_VERSION}, got {v}'" && \
    rm -rf /app/build /app/dist /app/*.egg-info /app/pyproject.toml /app/setup.py

ENV PATH=/app/.venv/bin:${PATH} \
    SUPERSET_HOME=/app/superset_home \
    HOME=/app/superset_home \
    SUPERSET_ENV=production \
    PYTHONPATH=/app/pythonpath \
    FLASK_APP=superset.app:create_app() \
    SUPERSET_PORT=8088 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=5008

RUN mkdir -p /app/superset_home /app/pythonpath && \
    chown -R 1001:0 /app && \
    chmod -R g=u /app

RUN cat <<'EOF' >/usr/local/bin/run-superset-and-mcp.sh
#!/usr/bin/env bash
set -euo pipefail

if [ "${SUPERSET_DB_UPGRADE:-true}" = "true" ]; then
  superset db upgrade
fi

if [ "${SUPERSET_CREATE_ADMIN:-false}" = "true" ]; then
  superset fab create-admin \
    --username "${SUPERSET_ADMIN_USERNAME:-admin}" \
    --firstname "${SUPERSET_ADMIN_FIRSTNAME:-Superset}" \
    --lastname "${SUPERSET_ADMIN_LASTNAME:-Admin}" \
    --email "${SUPERSET_ADMIN_EMAIL:-admin@superset.local}" \
    --password "${SUPERSET_ADMIN_PASSWORD:-admin}" || true
fi

superset init

/app/docker/entrypoints/run-server.sh &
SUPERSET_PID=$!

superset mcp run --host "${MCP_HOST}" --port "${MCP_PORT}" ${MCP_DEBUG:+--debug} &
MCP_PID=$!

wait -n "$SUPERSET_PID" "$MCP_PID"
exit $?
EOF

RUN chmod +x /usr/local/bin/run-superset-and-mcp.sh

HEALTHCHECK CMD /app/docker/docker-healthcheck.sh

EXPOSE 8088 5008

USER 1001

CMD ["/usr/local/bin/run-superset-and-mcp.sh"]
